{
  "name": "zeewbot",
  "version": "1.0.0",
  "description": "Bot de Discord para Zeew Space",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "concurrently --kill-others --names \"NODELINK,BOT\" --prefix-colors \"red,blue\" \"node scripts/startNodelink.js\" \"node dist/index.js\"",
    "dev": "concurrently --kill-others --names \"NODELINK,BOT\" --prefix-colors \"red,blue\" \"node scripts/startNodelink.js\" \"tsx watch src/index.ts\"",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clear-commands": "tsx src/clearCommands.ts",
    "clear-commands:global": "tsx src/clearCommands.ts --global",
    "manage-commands": "tsx src/manageCommands.ts",
    "nodelink": "node scripts/startNodelink.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "discord",
    "bot",
    "zeew"
  ],
  "author": "Zeew Space",
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.10",
    "deepseek-skills": "^2.1.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.1",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^5.3.2",
    "libsodium-wrappers": "^0.8.2",
    "msedge-tts": "^2.0.4",
    "prism-media": "^1.3.5",
    "shoukaku": "^4.3.0",
    "winston": "^3.11.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
